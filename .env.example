# C2C Configuration
# Make a copy of this file named '.env' and fill in your secure values.
# DO NOT commit '.env' to version control!

# A long, secure random string (minimum 32 characters)
SECRET_KEY=replace-with-a-secure-random-value

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Set to '1' in production if serving over HTTPS to ensure secure cookies
COOKIE_SECURE=1

# Automatically delete quizzes older than X days
QUIZ_RETENTION_DAYS=60
